<Window x:Class="DesktopReplay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DesktopReplay"
        xmlns:v="clr-namespace:DesktopReplay.Views"
        Title="DesktopReplay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="TileIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Field" TargetType="FrameworkElement">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="OptCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
            <Setter Property="Width" Value="460" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Scrim}" MouseDown="OnBackdropMouseDown">
        <!-- Header -->
        <Grid VerticalAlignment="Top" Margin="36,26,36,0">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app.ico" Width="30" Height="30" />
                <TextBlock Text="DesktopReplay" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Border x:Name="ReplayChip" CornerRadius="10" Padding="10,3" Margin="20,0,0,0" VerticalAlignment="Center" Background="{StaticResource Panel2}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ReplayChipDot" Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,7,0" />
                        <TextBlock x:Name="ReplayChipText" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border x:Name="RecChip" CornerRadius="10" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center" Background="#33EF4444" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,7,0" />
                        <TextBlock x:Name="RecChipText" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ActiveAppText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Style="{StaticResource GhostButton}" Click="OnClose" Padding="10,6" ToolTip="{l:T Close}">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Home -->
        <StackPanel x:Name="HomePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" MaxWidth="800" Visibility="Collapsed" />
            <WrapPanel HorizontalAlignment="Center" MaxWidth="1400">
                <!-- Instant replay -->
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIcon}" Text="&#xE81C;" />
                        <TextBlock Style="{StaticResource TileTitle}" Text="{l:T Replay}" />
                        <TextBlock x:Name="ReplayStatus" Style="{StaticResource Hint}" Height="34" />
                        <Grid Height="4" Margin="0,4,0,14">
                            <Border CornerRadius="2" Background="{StaticResource Hover}" />
                            <Border x:Name="BufferBar" CornerRadius="2" Background="{StaticResource Ok}" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Button x:Name="SaveReplayBtn" Style="{StaticResource AccentButton}" Click="OnSaveReplay" HorizontalAlignment="Stretch">
                            <TextBlock Text="{l:T SaveReplay}" Foreground="White" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="ReplayToggleBtn" Click="OnToggleReplay" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                        <Border Style="{StaticResource HotkeyChip}" Margin="0,12,0,0"><TextBlock x:Name="SaveKeyText" FontSize="11" Foreground="{StaticResource Muted}" /></Border>
                    </StackPanel>
                </Border>
                <!-- Record -->
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIcon}" Text="&#xE7C8;" />
                        <TextBlock Style="{StaticResource TileTitle}" Text="{l:T Record}" />
                        <TextBlock x:Name="RecordStatus" Style="{StaticResource Hint}" Height="34" />
                        <Border Height="4" Margin="0,4,0,14" />
                        <Button x:Name="RecordBtn" Click="OnToggleRecord" HorizontalAlignment="Stretch" />
                        <Border Style="{StaticResource HotkeyChip}" Margin="0,12,0,0"><TextBlock x:Name="RecordKeyText" FontSize="11" Foreground="{StaticResource Muted}" /></Border>
                    </StackPanel>
                </Border>
                <!-- Screenshot -->
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIcon}" Text="&#xE722;" />
                        <TextBlock Style="{StaticResource TileTitle}" Text="{l:T Screenshot}" />
                        <TextBlock Style="{StaticResource Hint}" Height="34" Text="PNG / JPG" />
                        <Border Height="4" Margin="0,4,0,14" />
                        <Button Click="OnScreenshot" HorizontalAlignment="Stretch" Content="{l:T TakeScreenshot}" />
                        <Border Style="{StaticResource HotkeyChip}" Margin="0,12,0,0"><TextBlock x:Name="ShotKeyText" FontSize="11" Foreground="{StaticResource Muted}" /></Border>
                    </StackPanel>
                </Border>
                <!-- Folder -->
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIcon}" Text="&#xE8B7;" />
                        <TextBlock Style="{StaticResource TileTitle}" Text="{l:T Gallery}" />
                        <TextBlock x:Name="StorageText" Style="{StaticResource Hint}" Height="34" />
                        <Grid Height="4" Margin="0,4,0,14">
                            <Border CornerRadius="2" Background="{StaticResource Hover}" />
                            <Border x:Name="StorageBar" CornerRadius="2" Background="{StaticResource Info}" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Button Click="OnOpenFolder" HorizontalAlignment="Stretch" Content="{l:T OpenFolder}" />
                    </StackPanel>
                </Border>
                <!-- Settings -->
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileIcon}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource TileTitle}" Text="{l:T Settings}" />
                        <TextBlock Style="{StaticResource Hint}" Height="34" Text="{l:T SettingsHint}" />
                        <Border Height="4" Margin="0,4,0,14" />
                        <Button Click="OnOpenSettings" HorizontalAlignment="Stretch" Content="{l:T Open}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Audio meters -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    Padding="20,14" Margin="8,16,8,0" HorizontalAlignment="Center">
                <ItemsControl x:Name="Meters">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,0" Width="150">
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                <Grid Height="6">
                                    <Border CornerRadius="3" Background="{StaticResource Hover}" />
                                    <Border CornerRadius="3" Background="{StaticResource Ok}" HorizontalAlignment="Left" Width="{Binding Width}" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="FooterHint" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>

        <!-- Settings -->
        <Border x:Name="SettingsPanel" Visibility="Collapsed" Width="1020" Height="720" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                Background="{StaticResource Bg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" Background="{StaticResource Panel}" CornerRadius="14,0,0,14" Padding="14,22">
                    <StackPanel>
                        <TextBlock Text="{l:T Settings}" FontSize="18" FontWeight="SemiBold" Margin="14,0,0,18" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="General" IsChecked="True" Checked="OnNav" Content="{l:T S.General}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Video" Checked="OnNav" Content="{l:T S.Video}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Audio" Checked="OnNav" Content="{l:T S.Audio}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Storage" Checked="OnNav" Content="{l:T S.Storage}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Hotkeys" Checked="OnNav" Content="{l:T S.Hotkeys}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Privacy" Checked="OnNav" Content="{l:T S.Privacy}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="About" Checked="OnNav" Content="{l:T S.About}" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="36,26,28,26">
                    <Grid>
                        <!-- General -->
                        <StackPanel x:Name="Sec_General">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T S.General}" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="{l:T S.Language}" />
                            <ComboBox x:Name="LanguageCombo" Style="{StaticResource OptCombo}" Width="220" SelectedValue="{Binding Language}" />
                            <CheckBox Margin="0,22,0,0" Content="{l:T S.ReplayEnabled}" IsChecked="{Binding ReplayEnabled}" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.ReplayLength}" />
                            <ComboBox x:Name="ReplayLengthCombo" Style="{StaticResource OptCombo}" Width="220" SelectedValue="{Binding ReplaySeconds}" SelectionChanged="OnDraftChanged" />
                            <TextBlock x:Name="ReplayLengthHint" Style="{StaticResource Hint}" MaxWidth="560" HorizontalAlignment="Left" />
                            <CheckBox Margin="0,22,0,0" Content="{l:T S.AutoStart}" IsChecked="{Binding AutoStart}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.AutoStartHint}" Margin="48,2,0,0" />
                            <CheckBox Content="{l:T S.NotifySound}" IsChecked="{Binding NotifySound}" Margin="0,16,0,0" />
                            <CheckBox Content="{l:T S.NotifyPopup}" IsChecked="{Binding NotifyPopup}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.NotifyHint}" Margin="48,2,0,0" />
                            <CheckBox Content="{l:T S.CheckUpdates}" IsChecked="{Binding CheckUpdates}" Margin="0,16,0,0" />
                        </StackPanel>

                        <!-- Video -->
                        <StackPanel x:Name="Sec_Video" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T S.Video}" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="{l:T S.Monitors}" />
                            <ItemsControl x:Name="MonitorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource TickBox}" Margin="0,4" Foreground="{StaticResource Text}" FontSize="13"
                                                  Content="{Binding Label}" IsChecked="{Binding Selected}" Checked="OnDraftChanged" Unchecked="OnDraftChanged" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.MonitorsHint}" MaxWidth="560" HorizontalAlignment="Left" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.Fps}" />
                            <ComboBox x:Name="FpsCombo" Style="{StaticResource OptCombo}" SelectedValue="{Binding Fps}" SelectionChanged="OnDraftChanged" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.Resolution}" />
                            <ComboBox x:Name="ResolutionCombo" Style="{StaticResource OptCombo}" SelectedValue="{Binding ResolutionHeight}" SelectionChanged="OnDraftChanged" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.ResolutionHint}" MaxWidth="560" HorizontalAlignment="Left" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.Codec}" />
                            <ComboBox x:Name="CodecCombo" Style="{StaticResource OptCombo}" SelectedValue="{Binding Codec}" SelectionChanged="OnDraftChanged" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding SelectedItem.Description, ElementName=CodecCombo}" MaxWidth="560" HorizontalAlignment="Left" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.Quality}" />
                            <ComboBox x:Name="QualityCombo" Style="{StaticResource OptCombo}" SelectedValue="{Binding Quality}" SelectionChanged="OnDraftChanged" />
                            <StackPanel x:Name="CustomBitratePanel" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{l:T S.Bitrate}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Width="80" Text="{Binding CustomBitrateMbps, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnTextChanged" />
                            </StackPanel>
                            <TextBlock x:Name="EstimateText" Style="{StaticResource Hint}" Foreground="{StaticResource Info}" />

                            <CheckBox Margin="0,22,0,0" Content="{l:T S.Cursor}" IsChecked="{Binding CaptureCursor}" />
                            <CheckBox Content="{l:T S.Hdr}" IsChecked="{Binding HdrToSdr}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.HdrHint}" Margin="48,2,0,0" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Audio -->
                        <StackPanel x:Name="Sec_Audio" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T S.Audio}" />
                            <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Hint}" Margin="0" Text="{l:T S.TracksInfo}" />
                            </Border>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.Mic}" />
                            <ComboBox x:Name="MicCombo" Style="{StaticResource OptCombo}" SelectedValue="{Binding Audio.MicDeviceId}" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.MicMode}" />
                            <ComboBox x:Name="MicModeCombo" Style="{StaticResource OptCombo}" SelectedValue="{Binding Audio.MicMode}" SelectionChanged="OnDraftChanged" />
                            <StackPanel x:Name="PushKeyPanel" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T S.PushKey}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <v:HotkeyBox SingleKey="True" Hotkey="{Binding Audio.PushKey}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="{l:T S.PushKeyHint}" MaxWidth="560" HorizontalAlignment="Left" />
                            </StackPanel>
                            <CheckBox Margin="0,18,0,0" Content="{l:T S.Noise}" IsChecked="{Binding Audio.NoiseSuppression}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.NoiseHint}" Margin="48,2,0,0" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.Volumes}" />
                            <Grid MaxWidth="620" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{l:T Track2}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Audio.GameVolume}" />
                                <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Text="{Binding Audio.GameVolume, StringFormat={}{0:P0}}" />
                                <CheckBox Grid.Column="3" Style="{StaticResource TickBox}" Content="{l:T S.InMix}" IsChecked="{Binding Audio.GameInMix}" />

                                <TextBlock Grid.Row="1" Text="{l:T Track3}" VerticalAlignment="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Audio.MicVolume}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Text="{Binding Audio.MicVolume, StringFormat={}{0:P0}}" />
                                <CheckBox Grid.Row="1" Grid.Column="3" Style="{StaticResource TickBox}" Content="{l:T S.InMix}" IsChecked="{Binding Audio.MicInMix}" />

                                <TextBlock Grid.Row="2" Text="{l:T Track4}" VerticalAlignment="Center" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Audio.SystemVolume}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Text="{Binding Audio.SystemVolume, StringFormat={}{0:P0}}" />
                                <CheckBox Grid.Row="2" Grid.Column="3" Style="{StaticResource TickBox}" Content="{l:T S.InMix}" IsChecked="{Binding Audio.SystemInMix}" />

                                <TextBlock Grid.Row="3" Text="{l:T Track5}" VerticalAlignment="Center" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Audio.DiscordVolume}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Text="{Binding Audio.DiscordVolume, StringFormat={}{0:P0}}" />
                                <CheckBox Grid.Row="3" Grid.Column="3" Style="{StaticResource TickBox}" Content="{l:T S.InMix}" IsChecked="{Binding Audio.DiscordInMix}" />
                            </Grid>

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.AudioBitrate}" />
                            <ComboBox x:Name="AudioBitrateCombo" Style="{StaticResource OptCombo}" Width="220" SelectedValue="{Binding Audio.AudioBitrateKbps}" SelectionChanged="OnDraftChanged" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.AudioBitrateHint}" />
                        </StackPanel>

                        <!-- Storage -->
                        <StackPanel x:Name="Sec_Storage" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T S.Storage}" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="{l:T S.Output}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="460" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="8,0,0,0" Content="{l:T Browse}" Click="OnBrowseOutput" />
                            </StackPanel>
                            <CheckBox Content="{l:T S.Subfolders}" IsChecked="{Binding SubfolderPerGame}" />
                            <TextBlock x:Name="UsageText" Style="{StaticResource Hint}" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.MaxSize}" />
                            <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding MaxFolderSizeGb, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.WarnAt}" />
                            <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding WarnAtPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.MaxSizeHint}" MaxWidth="560" HorizontalAlignment="Left" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.Buffer}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="460" Text="{Binding BufferFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="8,0,0,0" Content="{l:T Browse}" Click="OnBrowseBuffer" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.BufferHint}" />

                            <CheckBox Margin="0,22,0,0" Content="{l:T S.KeepMkv}" IsChecked="{Binding KeepMkv}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T S.KeepMkvHint}" Margin="48,2,0,0" MaxWidth="560" HorizontalAlignment="Left" />

                            <TextBlock Style="{StaticResource Label}" Text="{l:T S.ScreenshotFormat}" />
                            <ComboBox x:Name="ScreenshotCombo" Style="{StaticResource OptCombo}" Width="220" SelectedValue="{Binding ScreenshotFormat}" />
                        </StackPanel>

                        <!-- Hotkeys -->
                        <StackPanel x:Name="Sec_Hotkeys" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T S.Hotkeys}" />
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{l:T H.SaveReplay}" VerticalAlignment="Center" />
                                <v:HotkeyBox Grid.Column="1" Height="34" Hotkey="{Binding Hotkeys.SaveReplay}" LostKeyboardFocus="OnHotkeyLostFocus" />
                                <TextBlock Grid.Row="1" Text="{l:T H.ToggleReplay}" VerticalAlignment="Center" />
                                <v:HotkeyBox Grid.Row="1" Grid.Column="1" Height="34" Hotkey="{Binding Hotkeys.ToggleReplay}" LostKeyboardFocus="OnHotkeyLostFocus" />
                                <TextBlock Grid.Row="2" Text="{l:T H.ToggleRecording}" VerticalAlignment="Center" />
                                <v:HotkeyBox Grid.Row="2" Grid.Column="1" Height="34" Hotkey="{Binding Hotkeys.ToggleRecording}" LostKeyboardFocus="OnHotkeyLostFocus" />
                                <TextBlock Grid.Row="3" Text="{l:T H.Screenshot}" VerticalAlignment="Center" />
                                <v:HotkeyBox Grid.Row="3" Grid.Column="1" Height="34" Hotkey="{Binding Hotkeys.Screenshot}" LostKeyboardFocus="OnHotkeyLostFocus" />
                                <TextBlock Grid.Row="4" Text="{l:T H.Overlay}" VerticalAlignment="Center" />
                                <v:HotkeyBox Grid.Row="4" Grid.Column="1" Height="34" Hotkey="{Binding Hotkeys.Overlay}" LostKeyboardFocus="OnHotkeyLostFocus" />
                            </Grid>
                            <TextBlock x:Name="HotkeyWarning" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T H.Hint}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- Exclusions -->
                        <StackPanel x:Name="Sec_Privacy" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T X.Title}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T X.Hint}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,14" />
                            <ListBox x:Name="ExclusionList" Width="460" Height="180" HorizontalAlignment="Left" />
                            <Button Content="{l:T Remove}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRemoveExclusion" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:T X.Running}" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="RunningCombo" Width="360" DropDownOpened="OnRunningOpened" />
                                <Button Margin="8,0,0,0" Content="{l:T Add}" Click="OnAddRunning" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="ManualExclusion" Width="360" />
                                <Button Margin="8,0,0,0" Content="{l:T Add}" Click="OnAddManual" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T X.Manual}" />
                        </StackPanel>

                        <!-- About -->
                        <StackPanel x:Name="Sec_About" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="DesktopReplay" />
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="UpdateBtn" Content="{l:T A.CheckNow}" Click="OnCheckUpdates" />
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{l:T A.Logs}" Click="OnOpenLogs" />
                                <Button Content="{l:T A.Repo}" Click="OnOpenRepo" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="SystemInfo" Style="{StaticResource Hint}" Margin="0,24,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="36,14">
                    <Grid>
                        <TextBlock x:Name="RestartNote" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" Text="{l:T S.RestartNote}"
                                   MaxWidth="460" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:T Cancel}" Click="OnCancelSettings" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AccentButton}" Click="OnSaveSettings" Padding="22,7">
                                <TextBlock Text="{l:T Save}" Foreground="White" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
