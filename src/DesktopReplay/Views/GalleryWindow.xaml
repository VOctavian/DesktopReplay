<Window x:Class="DesktopReplay.Views.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DesktopReplay"
        xmlns:v="clr-namespace:DesktopReplay.Views"
        Title="{l:T G.Title}" Width="1360" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="UnitCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="70" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type v:VideoItem}">
            <Border Margin="6" CornerRadius="8" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    x:Name="card">
                <StackPanel>
                    <v:AspectBox>
                        <Grid Background="Black" Cursor="Hand" MouseLeftButtonUp="OnTilePreview" ToolTip="{l:T G.Preview}">
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,4000,4000" />
                            </Grid.Clip>
                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="#55FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="noThumb" Visibility="Collapsed" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,2" CornerRadius="4" Background="#C0000000">
                                <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="White" />
                            </Border>
                            <Border x:Name="play" Width="48" Height="48" CornerRadius="24" Background="#B0000000" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                    </v:AspectBox>
                    <StackPanel Margin="12,10,12,4">
                        <TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Path}" />
                        <TextBlock Text="{Binding InfoText}" Style="{StaticResource Small}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="{l:T G.Preview}" Click="OnPreview" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="{l:T G.Cut}" Click="OnCut" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{l:T OpenFolder}" Click="OnShowInFolder" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="{l:T G.OpenPlayer}" Click="OnOpenPlayer" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:T G.Delete}" Click="OnDelete" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Hover}" />
                    <Setter TargetName="play" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding Thumb}" Value="{x:Null}">
                    <Setter TargetName="noThumb" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: search -->
        <Grid Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="210">
                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Icons}" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="{l:T G.Title}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Column="1" Width="560" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" Padding="34,7,30,7" TextChanged="OnFilterChanged" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="{l:T G.Search}" Foreground="{StaticResource Muted}" Margin="35,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE71E;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" />
                <Slider x:Name="ZoomSlider" Width="130" Minimum="180" Maximum="560" Margin="8,0" VerticalAlignment="Center" ValueChanged="OnZoomChanged"
                        ToolTip="{l:T G.TileSize}" />
                <TextBlock Text="&#xE8A3;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="16" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{l:T G.Refresh}" Click="OnRefresh" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Groups -->
            <ListBox x:Name="GroupList" Background="Transparent" BorderThickness="0" Margin="12,0,4,12" SelectionChanged="OnGroupChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" FontSize="13.5" ToolTip="{Binding Display}" />
                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Grid.Column="1" Margin="4,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sort + quick date filters -->
                <WrapPanel Margin="6,0,6,8">
                    <TextBlock Text="{l:T G.Sort}" Style="{StaticResource Small}" Margin="0,0,8,0" />
                    <ComboBox x:Name="SortCombo" Width="190" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnFilterChanged" Margin="0,0,18,0" />
                    <ToggleButton x:Name="QToday" Style="{StaticResource Chip}" Content="{l:T G.Today}" Checked="OnQuickDate" Unchecked="OnQuickDate" Tag="today" />
                    <ToggleButton x:Name="QYesterday" Style="{StaticResource Chip}" Content="{l:T G.Yesterday}" Checked="OnQuickDate" Unchecked="OnQuickDate" Tag="yesterday" />
                    <ToggleButton x:Name="QWeek" Style="{StaticResource Chip}" Content="{l:T G.ThisWeek}" Checked="OnQuickDate" Unchecked="OnQuickDate" Tag="week" />
                    <ToggleButton x:Name="QLastWeek" Style="{StaticResource Chip}" Content="{l:T G.LastWeek}" Checked="OnQuickDate" Unchecked="OnQuickDate" Tag="lastweek" />
                    <ToggleButton x:Name="QOlder" Style="{StaticResource Chip}" Content="{l:T G.Older}" Checked="OnQuickDate" Unchecked="OnQuickDate" Tag="older" />
                </WrapPanel>

                <!-- Date range + duration -->
                <WrapPanel Grid.Row="1" Margin="6,0,6,10">
                    <TextBlock Text="{l:T G.Date}" Style="{StaticResource Small}" Margin="0,0,8,0" />
                    <DatePicker x:Name="DateFrom" SelectedDateChanged="OnDateChanged" />
                    <TextBlock Text="—" Style="{StaticResource Small}" Margin="6,0" />
                    <DatePicker x:Name="DateTo" SelectedDateChanged="OnDateChanged" Margin="0,0,22,0" />

                    <TextBlock Text="{l:T G.Length}" Style="{StaticResource Small}" Margin="0,0,8,0" />
                    <TextBlock Text="{l:T G.From}" Style="{StaticResource Small}" Margin="0,0,6,0" />
                    <TextBox x:Name="DurMin" Style="{StaticResource NumBox}" TextChanged="OnFilterChanged" />
                    <ComboBox x:Name="DurMinUnit" Style="{StaticResource UnitCombo}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnFilterChanged" />
                    <TextBlock Text="{l:T G.To}" Style="{StaticResource Small}" Margin="12,0,6,0" />
                    <TextBox x:Name="DurMax" Style="{StaticResource NumBox}" TextChanged="OnFilterChanged" />
                    <ComboBox x:Name="DurMaxUnit" Style="{StaticResource UnitCombo}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnFilterChanged" />

                    <Button Style="{StaticResource GhostButton}" Content="{l:T G.ResetFilters}" Click="OnResetFilters" Margin="14,0,0,0" Padding="10,5" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Small}" Margin="10,0,0,0" />
                </WrapPanel>

                <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnGridWheel">
                    <ItemsControl x:Name="TileList" ItemTemplate="{StaticResource TileTemplate}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <v:AdaptiveGrid TileWidth="{Binding Value, ElementName=ZoomSlider}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyPanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
